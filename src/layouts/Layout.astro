---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PageFind from "@components/PageFind.astro";
import { SITE } from "@consts";
import "../styles/site.css";
interface Props {
  title: string;
  description: string;
  home?: boolean;
  lang?: string;
  article?: boolean;
  published?: Date;
  modified?: Date;
  noindex?: boolean;
}
const {
  title,
  description,
  home = false,
  lang = "en",
  article = false,
  published,
  modified,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head
    ><Head
      title={title.includes(SITE.TITLE) ? title : `${title} | ${SITE.TITLE}`}
      description={description}
      article={article}
      published={published}
      modified={modified}
      noindex={noindex}
    />
    {
      import.meta.env.PROD && (
        <>
          <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-SY0D1STNSD"
          />
          <script is:inline>
            window.dataLayer = window.dataLayer || []; function gtag()
            {dataLayer.push(arguments)}
            gtag('js', new Date()); gtag('config', 'G-SY0D1STNSD');
          </script>
        </>
      )
    }
  </head>
  <body id="top" class:list={["portfolio-site", { "home-page": home }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main
      id="main"
      tabindex="-1"
      data-pagefind-body={noindex ? undefined : ""}
      data-pagefind-ignore={noindex ? "" : undefined}
      class:list={{ "inner-main": !home }}
    >
      <slot />
    </main>
    <Footer />
    <PageFind />
  </body>
</html>
