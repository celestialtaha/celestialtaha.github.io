---
import Layout from "@layouts/Layout.astro";
import ProjectVisual from "@components/ProjectVisual.astro";
import { HOME, SITE } from "@consts";
import { getCollection } from "astro:content";
import { featuredProjects } from "../lib/portfolio";
import "../styles/home.css";
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 2);
const research = await getCollection("research");
const selectedResearch = research.filter((r) =>
  ["3drec", "medvse"].includes(r.slug),
);
const projects = (await getCollection("projects")).filter((p) => !p.data.draft);
const work = (await getCollection("work")).sort(
  (a, b) => +new Date(b.data.dateStart) - +new Date(a.data.dateStart),
);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} home>
  <section class="portfolio-hero" aria-labelledby="hero-title">
    <div class="hero-topline">
      <span class="eyebrow"
        ><span class="status-dot"></span> RESEARCH → SYSTEMS → PRODUCTS</span
      ><span class="eyebrow">PERSONAL PORTFOLIO / SELECTED WORK</span>
    </div>
    <div class="hero-grid">
      <div class="hero-intro">
        <div class="intro-person">
          <img
            src="/images/profile.jpeg"
            alt="Portrait of Taha Samavati"
            width="42"
            height="42"
          /><span>Hello, I’m Taha.</span>
        </div><h1 id="hero-title">
          AI engineer.<br />Researcher.<br /><em>Builder.</em>
        </h1><p>
          I build intelligent systems, from how machines see and understand to
          the products people use.
        </p><div class="hero-actions">
          <a class="primary-link" href="#selected-work"
            >Explore my work <span>↓</span></a
          ><a class="quiet-link" href="/work">My experience ↗</a>
        </div>
      </div>
      <div class="hero-observatory">
        <div class="observatory-label">
          <button class="motion-toggle" type="button" hidden aria-pressed="false">Pause motion</button>
          <span class="mono">A STUDY IN PERCEPTION</span><span class="mono"
            >X / Y / Z</span>
        </div><div class="particle-field">
          <canvas id="intelligence-scene" aria-hidden="true"></canvas><span
            class="axis axis-y">Y</span
          ><span class="axis axis-x">X</span><span class="field-tag"
            >POINTS → PATTERNS → UNDERSTANDING</span>
        </div><div class="observatory-bottom">
          <span class="status-dot"></span><span
            >Making sense of complex things.</span
          ><span class="mono">01 — ∞</span>
        </div>
      </div>
    </div>
    <div class="hero-signature">
      <span class="signature-name">Taha Samavati<span>©</span></span><span
        class="signature-note"
        >A PRACTICE BETWEEN<br />SCIENTIFIC CURIOSITY & EVERYDAY UTILITY.</span>
    </div>
  </section>
  <section
    id="selected-work"
    class="work-narrative"
    aria-labelledby="work-title"
  >
    <div class="section-top">
      <span class="eyebrow">01 / THE WORK</span><h2 id="work-title">
        Selected work.<br /><em>Connected by curiosity.</em>
      </h2><p>
        A selection of projects across machine learning, applied research, and
        software.
      </p>
    </div>
    <div class="work-layout">
      <div class="work-stage">
        <div class="stage-frame">
          {
            featuredProjects.map((project, index) => (
              <div
                class:list={["stage-view", { "is-active": index === 0 }]}
                data-scene={index}
              >
                <ProjectVisual kind={project.visual} />
              </div>
            ))
          }
        </div><div
          class="stage-switcher"
          aria-label="Explore featured projects"
        >
          {
            featuredProjects.map((project, index) => (
              <button
                type="button"
                data-chapter-button={index}
                aria-pressed={index === 0}
                aria-controls={`chapter-${project.slug}`}
              >
                <span>{project.number}</span>
                {project.shortName}
              </button>
            ))
          }
        </div><div class="stage-footnote">
          <span>SCROLL TO FOLLOW THE WORK</span><span>↓</span>
        </div>
      </div>
      <div class="work-chapters">
        {
          featuredProjects.map((project, index) => (
            <section
              class="work-chapter"
              data-chapter={index}
              id={`chapter-${project.slug}`}
              aria-labelledby={`project-${project.slug}`}
            >
              <>
                <div class="chapter-mobile-visual">
                  <ProjectVisual kind={project.visual} />
                </div>
                <span class="eyebrow">
                  {project.number} / {project.category} / {project.year}
                </span>
                <div class="chapter-discipline">{project.discipline}</div>
                <h3 id={`project-${project.slug}`}>{project.name}</h3>
                <p class="chapter-hook">{project.description}</p>
                <p class="chapter-detail">{project.detail}</p>
                <div class="chapter-contribution">
                  <>
                    <span class="eyebrow">THE WORK</span>
                    <p>{project.contribution}</p>
                  </>
                </div>
                <div class="pill-list">
                  {project.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </div>
                <a class="project-link" href={`/projects/${project.slug}/`} aria-label={`Explore ${project.name}`}>
                  Explore project <span>↗</span>
                </a>
              </>
            </section>
          ))
        }
      </div>
    </div>
    <a href="/projects" class="archive-callout"
      ><span>There’s more in the archive.</span><span class="mono"
        >EXPLORE ALL {projects.length} PROJECTS ↗</span
      ></a
    >
  </section>
  <section class="research-preview">
    <div class="research-preview-intro">
      <span class="eyebrow">02 / THE RESEARCH</span><h2>
        Research,<br /><em>put to work.</em>
      </h2><p>
        My research explores how machines perceive the world, learn from data,
        and work within real-world constraints.
      </p><a class="text-link" href="/research"
        >All {research.length} research publications ↗</a>
    </div><div class="research-preview-list">
      {
        selectedResearch.map((paper, index) => (
          <a href={paper.data.link} class="paper-preview">
            <>
              <span class="mono">
                0{index + 1} /{" "}
                {new Date(paper.data.publicationDate).getFullYear()}
              </span>
              <h3>{paper.data.title}</h3>
              <span class="paper-venue">
                {paper.data.journal} <span>↗</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section id="about" class="about-portfolio">
    <div class="about-portrait">
      <img
        src="/images/profile.jpeg"
        alt="Taha Samavati"
        width="420"
        height="500"
        loading="lazy"
      /><span class="mono">TAHA SAMAVATI / ALWAYS EXPLORING</span>
    </div><div class="about-story">
      <span class="eyebrow">03 / A LITTLE CONTEXT</span><h2>
        Research-minded.<br /><em>Hands-on.</em>
      </h2><p>
        I’m Taha, an AI engineer and researcher working across generative AI,
        computer vision, and product development.
      </p><p>
        I like taking an idea through the whole process: understanding the
        problem, experimenting with models, and building something that works in
        the real world. Lately, that curiosity has led me to multi-agent systems
        and LLM reasoning.
      </p><div class="experience-preview">
        {
          work.slice(0, 2).map((w) => (
            <div>
              <>
                <span class="mono">
                  {w.data.dateEnd === "Current" ? "CURRENT" : "PREVIOUSLY"}
                </span>
                <span>
                  {w.data.company}
                  <small>{w.data.role}</small>
                </span>
              </>
            </div>
          ))
        }
      </div><a class="text-link" href="/work">My experience ↗</a>
    </div>
  </section>
  <section class="writing-preview">
    <div class="section-top">
      <span class="eyebrow">04 / THE NOTEBOOK</span><h2>
        What I’m<br /><em>thinking about.</em>
      </h2><a class="text-link" href="/blog">All writing ↗</a>
    </div>{
      posts.map((post) => (
        <a class="notebook-row" href={`/blog/${post.slug}/`}>
          <>
            <span class="mono">{post.data.date.getFullYear()} / NOTE</span>
            <h3 dir={post.data.rtl ? "rtl" : "ltr"} lang={post.data.rtl ? "fa" : "en"}>{post.data.title}</h3>
            <span>↗</span>
          </>
        </a>
      ))
    }
  </section>
  <section class="home-contact">
    <span class="eyebrow">HAVE AN INTERESTING PROBLEM?</span><a
      href={`mailto:${SITE.EMAIL}`}
      >Let’s figure it <em>out.</em><span>↗</span></a
    ><p>
      Research collaborations, thoughtful products, or a good conversation.
    </p>
  </section>
</Layout>
<script src="../scripts/home.ts"></script>
