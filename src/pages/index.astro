---
import Layout from "@layouts/Layout.astro";
import ProjectVisual from "@components/ProjectVisual.astro";
import { featuredProjects } from "../lib/portfolio";
import { HOME, SITE } from "@consts";
import { getCollection } from "astro:content";
import { publicationVenue } from "../lib/research";
import "../styles/home.css";
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 2);
const research = await getCollection("research");
const selectedResearch = research
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const work = (await getCollection("work")).sort(
  (a, b) => +new Date(b.data.dateStart) - +new Date(a.data.dateStart),
);
const projects = (await getCollection("projects")).filter((p) => !p.data.draft);
const expertise = [
  {
    id: "agents",
    label: "Agents",
    kicker: "01 / AGENT SYSTEMS",
    title: "Reason. Act.",
    emphasis: "Check.",
    description:
      "Agents need more than a prompt. They need useful tools, relevant context, and a way to evaluate what happens next.",
    detail: "Tool use · Memory & context · Evaluation",
    href: "/work",
    action: "Professional experience",
  },
  {
    id: "orchestration",
    label: "Orchestration",
    kicker: "02 / ORCHESTRATION",
    title: "Make the parts",
    emphasis: "work together.",
    description:
      "Route the task. Coordinate the work. Bring the result back together. The interesting part is how the whole system behaves.",
    detail: "Workflows · Coordination · Task routing",
    href: "/blog/10-context-engineering/",
    action: "Notes on context engineering",
  },
  {
    id: "backend",
    label: "Backend",
    kicker: "03 / BACKEND ENGINEERING",
    title: "Behind every",
    emphasis: "working idea.",
    description:
      "APIs, background workers, data and retrieval. The foundations that turn an AI experiment into usable software.",
    detail: "Python · APIs · Queues · Data systems",
    href: "/projects",
    action: "Explore the engineering archive",
  },
  {
    id: "research",
    label: "Research",
    kicker: "04 / APPLIED RESEARCH",
    title: "Look closer.",
    emphasis: "Ask better.",
    description:
      "My research explores machine perception and efficient learning, from reconstructing geometry to recovering vital signs from light.",
    detail: "3D perception · Deep learning · Mobile inference",
    href: "/research",
    action: "Research & publications",
  },
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} home>
  <section class="signal-story" aria-label="Areas of practice" id="story">
    <div class="story-viewport">
      <div class="story-topline">
        <span class="eyebrow">TAHA SAMAVATI / SELECTED PRACTICE</span><a
          href="#selected-work">Skip to projects ↘</a
        >
      </div>
      <div class="story-art" aria-hidden="true">
        <div class="scene-fallback">
          <span>PLAN</span><i>→</i><span>ACT</span><i>→</i><span>CHECK</span
          ><small>AGENTS / ORCHESTRATION / SYSTEMS</small>
        </div>
        <canvas id="intelligence-scene"></canvas>
        <div class="scene-caption">
          <span data-scene-label>00 / THE INTELLIGENCE WORKBENCH</span><span
            >AN ILLUSTRATED VIEW OF MY PRACTICE</span
          >
        </div>
      </div>
      <div class="story-panels">
        <section
          class="story-panel story-opening"
          data-story-panel="0"
          id="practice-overview"
          aria-labelledby="hero-title"
        >
          <span class="story-kicker"
            ><span class="status-dot"></span>AI ENGINEER & RESEARCHER</span
          >
          <h1 id="hero-title">Intelligence,<br /><em>engineered.</em></h1>
          <p>
            I’m Taha. I work across AI agents, orchestration, backend systems
            and applied research.
          </p>
          <a class="story-link" href="#practice-agents"
            >Explore my practice <span>↓</span></a
          >
        </section>
        {
          expertise.map((area, index) => (
            <section
              class="story-panel"
              data-story-panel={index + 1}
              id={`practice-${area.id}`}
              aria-labelledby={`${area.id}-title`}
            >
              <span class="story-kicker">{area.kicker}</span>
              <h2 id={`${area.id}-title`}>
                {area.title}
                <br />
                <em>{area.emphasis}</em>
              </h2>
              <p>{area.description}</p>
              <div class="story-project">
                <>
                  <span>{area.detail}</span>
                  <a href={area.href}>
                    {area.action}
                    <span>↗</span>
                  </a>
                </>
              </div>
            </section>
          ))
        }
      </div>
      <div class="story-controls" hidden>
        <div class="story-index" aria-label="Areas of practice">
          {
            [
              "Overview",
              ...expertise.map((a) =>
                a.id === "orchestration" ? "Routing" : a.label,
              ),
            ].map((label, i) => (
              <button
                type="button"
                data-story-button={i}
                aria-pressed={i === 0}
                aria-controls={
                  i === 0
                    ? "practice-overview"
                    : `practice-${expertise[i - 1].id}`
                }
              >
                <>
                  <span>0{i}</span>
                  <span>{label}</span>
                </>
              </button>
            ))
          }
        </div>
        <div class="story-progress" aria-hidden="true"><span></span></div>
        <button class="motion-toggle" type="button" aria-pressed="false"
          >Static view <span aria-hidden="true">Ⅱ</span></button
        >
      </div>
    </div>
  </section>

  <section
    id="selected-work"
    class="selected-work home-container"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <span class="eyebrow">A FEW THINGS I’VE BUILT</span><h2 id="work-title">
          Ideas, <em>in practice.</em>
        </h2>
      </div><a class="text-link" href="/projects">All {projects.length} projects ↗</a>
    </div>
    <div class="selected-grid">
      {featuredProjects.map((project) => (
        <a class="selected-project" href={`/projects/${project.slug}/`}>
          <ProjectVisual kind={project.visual} />
          <div class="selected-project-meta">
            <span class="eyebrow">{project.category}</span>
            <span class="mono">{project.year}</span>
          </div>
          <h3>{project.name}<span aria-hidden="true">↗</span></h3>
          <p>{project.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="research-preview" aria-labelledby="research-preview-title">
    <div class="home-container research-inner">
      <div class="research-preview-intro">
        <span class="eyebrow">THE RESEARCH BEHIND THE WORK</span><h2
          id="research-preview-title"
        >
          A question.<br /><em>Then a little further.</em>
        </h2><p>
          Exploring how machines perceive, learn, and work within real-world
          constraints.
        </p><a class="text-link" href="/research"
          >All {research.length} publications ↗</a
        >
      </div>
      <div class="research-preview-list">
        {
          selectedResearch.map((p) => (
            <a href={p.data.link} class="paper-preview">
              <>
                <span class="eyebrow">
                  {p.data.publicationDate.getFullYear()} /{" "}
                  {p.data.status === "preprint"
                    ? "PREPRINT"
                    : "JOURNAL ARTICLE"}
                </span>
                <h3>{p.data.title}</h3>
                <span class="paper-venue">
                  {publicationVenue(p.data)}
                  <span>↗</span>
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="about"
    class="about-portfolio home-container"
    aria-labelledby="about-title"
  >
    <div class="about-portrait">
      <img
        src="/images/profile.jpeg"
        alt="Taha Samavati"
        width="420"
        height="500"
        loading="lazy"
      /><span class="mono">TAHA SAMAVATI</span>
    </div>
    <div class="about-story">
      <span class="eyebrow">THE PERSON BEHIND THE SYSTEMS</span><h2
        id="about-title"
      >
        Curious by nature.<br /><em>Hands-on by choice.</em>
      </h2><p>
        I’m an AI engineer and researcher working across generative AI, computer
        vision, and product development.
      </p><p>
        I like taking an idea through the whole process: understanding the
        problem, experimenting with models, and building something that works in
        the real world. Lately, that curiosity has led me to multi-agent systems
        and LLM reasoning.
      </p><div class="experience-preview">
        {
          work.slice(0, 2).map((w) => (
            <div>
              <>
                <span class="mono">
                  {w.data.dateEnd === "Current" ? "CURRENT" : "PREVIOUSLY"}
                </span>
                <span>
                  {w.data.company}
                  <small>{w.data.role}</small>
                </span>
              </>
            </div>
          ))
        }
      </div><a class="text-link" href="/work">My experience ↗</a>
    </div>
  </section>

  <section
    class="writing-preview home-container"
    aria-labelledby="writing-title"
  >
    <div class="section-heading">
      <div>
        <span class="eyebrow">NOTES ALONG THE WAY</span><h2 id="writing-title">
          Thinking <em>out loud.</em>
        </h2>
      </div><a class="text-link" href="/blog">All writing ↗</a>
    </div>{
      posts.map((post) => (
        <a class="notebook-row" href={`/blog/${post.slug}/`}>
          <>
            <span class="mono">{post.data.date.getFullYear()} / NOTE</span>
            <h3
              dir={post.data.rtl ? "rtl" : "ltr"}
              lang={post.data.rtl ? "fa" : "en"}
            >
              {post.data.title}
            </h3>
            <span aria-hidden="true">↗</span>
          </>
        </a>
      ))
    }
  </section>
  <section class="home-contact">
    <div class="home-container">
      <span class="eyebrow">WHAT ARE YOU THINKING ABOUT?</span><a
        href={`mailto:${SITE.EMAIL}`}
        >Let’s make<br /><em>something matter.</em><span>↗</span></a
      ><p>
        Research collaborations, thoughtful products, or a good conversation.
      </p>
    </div>
  </section>
</Layout>
<script src="../scripts/home.ts"></script>
