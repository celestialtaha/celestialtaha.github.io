---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { dateRange } from "@lib/utils";
import { WORK } from "@consts";
const collection = (await getCollection("work")).sort(
  (a, b) => +new Date(b.data.dateStart) - +new Date(a.data.dateStart),
);
const work = await Promise.all(
  collection.map(async (entry) => ({ ...entry, ...(await entry.render()) })),
);
---

<Layout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <div class="page-intro">
    <span class="eyebrow">TAHA SAMAVATI / EXPERIENCE</span><h1>
      Experience,<br /><em>in practice.</em>
    </h1><p>
      My path through software, machine learning, and AI product development.
      Connecting experimentation with the work of shipping.
    </p>
  </div>
  {
    work.map((entry) => (
      <section class="experience-row">
        <>
          <div class="experience-meta">
            <span class="eyebrow">{dateRange(entry.data.dateStart, entry.data.dateEnd)}</span>
            <h2>{entry.data.company}</h2>
            {entry.data.website && !entry.data.website.startsWith("#") && (
              <a class="text-link" href={entry.data.website}>
                Company ↗
              </a>
            )}
          </div>
          <div class="experience-content">
            <h3>{entry.data.role}</h3>
            {entry.body.trim() && <div><entry.Content /></div>}
            {entry.data.skills && (
              <div class="pill-list">
                {entry.data.skills.map((skill) => (
                  <span>{skill}</span>
                ))}
              </div>
            )}
            {entry.slug === "vitalmo" && (
              <a class="text-link" href="/projects/medvse/">
                Related work: MEDVSE ↗
              </a>
            )}
          </div>
        </>
      </section>
    ))
  }
</Layout>
