---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { readingTime } from "@lib/utils";
import TableOfContents from "@components/TableOfContents.astro";
import PostNavigation from "@components/PostNavigation.astro";
import Giscus from "@components/Giscus.astro";
import "../../styles/rtl.css";
export async function getStaticPaths() {
  return (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.slug }, props: post }));
}
type Props = CollectionEntry<"blog">;
const post = Astro.props;
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
const index = posts.findIndex((p) => p.slug === post.slug);
const { Content, headings } = await post.render();
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang={post.data.rtl ? "fa" : "en"}
  article
  published={post.data.date}
  modified={post.data.updated}
>
  <div class="reading-shell">
    <a lang="en" class="text-link" href="/blog">← All writing</a><div
      class="detail-header"
      dir={post.data.rtl ? "rtl" : "ltr"}
    >
      <span class="eyebrow" lang="en" dir="ltr"
        >{
          post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        } / {readingTime(post.body)}{
          post.data.updated && (
            <span>
              {" "}
              / Revised{" "}
              {post.data.updated.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
                timeZone: "UTC",
              })}
            </span>
          )
        }</span
      ><h1 data-pagefind-weight="10">{post.data.title}</h1><p>
        {post.data.description}
      </p>
    </div>{
      headings.length > 0 && (
        <TableOfContents
          headings={headings}
          lang={post.data.rtl ? "fa" : "en"}
        />
      )
    }<article class:list={{ rtl: post.data.rtl }}><Content /></article><div
      style="margin-top:65px"
    >
      <PostNavigation prevPost={posts[index - 1]} nextPost={posts[index + 1]} />
    </div><div style="margin-top:65px"><Giscus /></div>
  </div>
</Layout>
