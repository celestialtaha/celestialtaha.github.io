---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { BLOG } from "@consts";
import { readingTime } from "@lib/utils";
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <div class="page-intro">
    <span class="eyebrow">TAHA SAMAVATI / WRITING</span><h1>
      Notes &<br /><em>ideas.</em>
    </h1><p>
      Notes on AI, research, and the ideas I’m trying to understand. Written in
      English and Persian.
    </p>
  </div>
  <div class="writing-list">
    <div class="archive-label">
      <span class="mono">{posts.length} NOTES & ARTICLES</span><a
        class="mono"
        href="/rss.xml">RSS FEED ↗</a>
    </div>{
      posts.map((post) => (
        <a class="article-link" href={`/blog/${post.slug}/`}>
          <>
            <span class="mono">
              {post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
              })}
            </span>
            <div dir={post.data.rtl ? "rtl" : "ltr"} lang={post.data.rtl ? "fa" : "en"}>
              <>
                <h2 data-pagefind-weight="1">{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="mono">
                  {readingTime(post.body)} /{" "}
                  {post.data.rtl ? "فارسی" : "ENGLISH"}
                </span>
              </>
            </div>
            <span>↗</span>
          </>
        </a>
      ))
    }
  </div>
</Layout>
