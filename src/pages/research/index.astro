---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { RESEARCH } from "@consts";
import "../../styles/research.css";
import scholar from "../../data/scholar.json";
import { publicationVenue, bibtex } from "../../lib/research";
const entries = (await getCollection("research")).sort(
  (a, b) => +b.data.publicationDate - +a.data.publicationDate,
);
---

<Layout title={RESEARCH.TITLE} description={RESEARCH.DESCRIPTION}>
  <div class="research-heading">
    <div>
      <span class="eyebrow">PUBLICATIONS & PREPRINTS</span><h1>
        Research<em>.</em>
      </h1>
    </div><div>
      <p>
        Research in machine perception, language, and efficient learning. From a
        better understanding to a working system.
      </p><a
        class="text-link"
        href="https://scholar.google.com/citations?user=umQn3lcAAAAJ&hl=en"
        >Google Scholar ↗</a
      >
    </div>
  </div>
  <div class="research-overview">
    <span class="mono"
      >{entries.length} WORKS <span
        >{entries.filter((p) => p.data.kind === "journal").length} JOURNAL · {
          entries.filter((p) => p.data.kind === "conference").length
        } CONFERENCE · {
          entries.filter((p) => p.data.kind === "preprint").length
        } PREPRINTS</span
      ></span
    ><div>
      <strong>{scholar.citations}</strong> citations <span
        >h-index <strong>{scholar.hIndex}</strong></span
      ><small
        >{scholar.provider} · {
          new Date(scholar.asOf).toLocaleDateString("en-GB", {
            day: "numeric",
            month: "short",
            year: "numeric",
            timeZone: "UTC",
          })
        }</small
      >
    </div>
  </div>
  <div class="research-list">
    {
      entries.map((entry) => (
        <section
          class:list={[
            "research-entry",
            { "featured-paper": !!entry.data.featured },
          ]}
          id={entry.slug}
          aria-labelledby={`paper-${entry.slug}`}
        >
          <div class="paper-year">
            <>
              <span>{entry.data.publicationDate.getFullYear()}</span>
              <span
                class:list={[
                  "publication-status",
                  { "is-preprint": entry.data.status === "preprint" },
                ]}
              >
                {entry.data.status === "preprint"
                  ? "Preprint"
                  : entry.data.kind === "conference"
                    ? "Conference"
                    : "Journal"}
              </span>
            </>
          </div>
          <div class="paper-main">
            <span class="venue">{publicationVenue(entry.data)}</span>
            <h2 id={`paper-${entry.slug}`}>
              <a href={entry.data.link}>
                {entry.data.title}
                <span aria-hidden="true">↗</span>
              </a>
            </h2>
            <p class="paper-authors">
              {entry.data.authors.map((author, i) => (
                <>
                  {i > 0 ? ", " : ""}
                  {author === "Taha Samavati" ? (
                    <strong>{author}</strong>
                  ) : (
                    author
                  )}
                </>
              ))}
            </p>
            <p class="paper-summary">{entry.data.summary}</p>
            <div class="entry-links">
              <a href={entry.data.link}>Read paper ↗</a>
              {entry.data.openAccess && (
                <a href={entry.data.openAccess}>Open access ↗</a>
              )}
              {entry.data.pdf && <a href={entry.data.pdf}>PDF ↗</a>}
              {entry.data.code && <a href={entry.data.code}>Code ↗</a>}
              {entry.slug === "medvse" && (
                <a href="/projects/medvse/">Related project ↗</a>
              )}
            </div>
            {entry.data.versions.length > 0 && (
              <div class="paper-versions">
                <span class="mono">EARLIER VERSION</span>
                {entry.data.versions.map((v) => (
                  <a href={v.url}>
                    {v.year} / {v.title} ↗
                  </a>
                ))}
              </div>
            )}
            {entry.data.revised && (
              <p class="revision-note">
                First posted 2019 · Latest revision October 2023
              </p>
            )}
            <details class="paper-cite">
              <>
                <summary>
                  Cite this work <span aria-hidden="true">+</span>
                </summary>
                <pre tabindex="0">
                  <code>{bibtex(entry)}</code>
                </pre>
              </>
            </details>
          </div>
        </section>
      ))
    }
  </div>
  <p class="research-source-note">
    Publication records checked against publisher and arXiv sources on 2
    November 2026. Preprints and later journal versions are grouped as one work.
    Citation metrics are a dated Scholar snapshot.
  </p>
</Layout>
