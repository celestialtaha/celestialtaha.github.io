---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { RESEARCH } from "@consts";
const research = (await getCollection("research")).sort((a, b) => {
  const pending = (value: string | Date) =>
    value === "Forthcoming" || value === "In Review";
  if (pending(a.data.publicationDate) !== pending(b.data.publicationDate))
    return pending(a.data.publicationDate) ? -1 : 1;
  return (
    (+new Date(b.data.publicationDate) || 0) -
    (+new Date(a.data.publicationDate) || 0)
  );
});
const entries = await Promise.all(
  research.map(async (item) => ({ ...item, ...(await item.render()) })),
);
function dateLabel(date: string | Date) {
  return date === "Forthcoming" || date === "In Review"
    ? date
    : new Date(date).getFullYear();
}
---

<Layout title={RESEARCH.TITLE} description={RESEARCH.DESCRIPTION}>
  <div class="page-intro">
    <span class="eyebrow">TAHA SAMAVATI / RESEARCH</span><h1>
      Research &<br /><em>publications.</em>
    </h1><p>
      Publications across computer vision, 3D perception, natural language
      processing, and mobile health. The research behind my practice.
    </p>
  </div>
  <div class="research-list">
    <div class="research-context">
      <span class="mono">{entries.length} PUBLICATIONS / 2019 — PRESENT</span><a
        href="/projects/medvse/">See research in practice: MEDVSE ↗</a>
    </div>
    {
      entries.map((entry) => (
        <section class="research-entry" id={entry.slug}>
          <>
            <span>{dateLabel(entry.data.publicationDate)}</span>
            <div>
              <>
                <span class="venue">{entry.data.journal.trim()}</span>
                <h2>
                  {entry.data.link ? (
                    <a href={entry.data.link}>{entry.data.title} ↗</a>
                  ) : (
                    entry.data.title
                  )}
                </h2>
                <p>
                  {entry.data.authors.map((author, i) => (
                    <>
                      {i > 0 ? ", " : ""}
                      {author === "Taha Samavati" ? (
                        <strong>{author}</strong>
                      ) : (
                        author
                      )}
                    </>
                  ))}
                </p>
                <div class="research-abstract">
                  <entry.Content />
                </div>
                <div class="entry-links">
                  {entry.data.link && (
                    <a href={entry.data.link}>Read paper ↗</a>
                  )}
                  {entry.data.pdf && <a href={entry.data.pdf}>PDF ↗</a>}
                  {entry.data.code && <a href={entry.data.code}>Code ↗</a>}
                  {entry.data.demo && <a href={entry.data.demo}>Demo ↗</a>}
                  {entry.slug === "medvse" && (
                    <a href="/projects/medvse/">Related project ↗</a>
                  )}
                </div>
              </>
            </div>
          </>
        </section>
      ))
    }
  </div>
</Layout>
