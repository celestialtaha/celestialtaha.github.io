---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ProjectVisual from "@components/ProjectVisual.astro";
import ProjectSystem from "@components/ProjectSystem.astro";
import ResearchResults from "@components/ResearchResults.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { featuredProjects, projectVisual } from "../../lib/portfolio";
export async function getStaticPaths() {
  return (await getCollection("projects"))
    .filter((p) => !p.data.draft)
    .map((project) => ({ params: { slug: project.slug }, props: project }));
}
type Props = CollectionEntry<"projects">;
const project = Astro.props;
const { Content, headings } = await project.render();
const pageHeadings =
  project.slug === "medvse"
    ? [
        ...headings,
        { depth: 2, slug: "result-title", text: "Model comparison" },
      ]
    : headings;
const index = featuredProjects.findIndex((p) => p.slug === project.slug);
const featured = featuredProjects[index];
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
const ordered = [
  ...featuredProjects.map(
    (p) => projects.find((entry) => entry.slug === p.slug)!,
  ),
  ...projects.filter((p) => !featuredProjects.some((f) => f.slug === p.slug)),
];
const next =
  ordered[
    (ordered.findIndex((p) => p.slug === project.slug) + 1) % ordered.length
  ];
---

<Layout title={project.data.title} description={project.data.description}>
  <div class="reading-shell">
    <a class="text-link" href="/projects">← All projects</a><div
      class="detail-header"
    >
      <span class="eyebrow"
        >{featured?.category || "SOFTWARE & MACHINE LEARNING"} / {
          featured?.year || project.data.date.getFullYear()
        }</span
      ><h1 data-pagefind-weight="10">{project.data.title}</h1><p>
        {project.data.description}
      </p><div class="entry-links">
        {
          project.data.repoURL && (
            <a href={project.data.repoURL}>View source ↗</a>
          )
        }{
          project.data.demoURL &&
            project.data.demoURL !== project.data.repoURL && (
              <a href={project.data.demoURL}>Explore demo ↗</a>
            )
        }{
          project.slug === "medvse" && (
            <a href="/research/#medvse">Related research ↗</a>
          )
        }
      </div>
    </div>
    {
      featured && (
        <div class="detail-visual">
          <ProjectVisual kind={projectVisual(project.slug)} />
        </div>
      )
    }
    {
      featured && (
        <div class="detail-contribution">
          <>
            <span class="eyebrow">THE WORK</span>
            <p>{featured.contribution}</p>
            <div class="pill-list">
              {featured.stack.map((s) => (
                <span>{s}</span>
              ))}
            </div>
          </>
        </div>
      )
    }<ProjectSystem slug={project.slug} />{
      pageHeadings.length > 0 && <TableOfContents headings={pageHeadings} />
    }<article>
      <Content />
    </article>{project.slug === "medvse" && <ResearchResults />}<div
      class="next-project"
    >
      <span class="eyebrow">NEXT PROJECT</span><a
        href={`/projects/${next.slug}/`}>{next.data.title}<span>↗</span></a
      >
    </div>
  </div>
</Layout>
