---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ProjectVisual from "@components/ProjectVisual.astro";
import { PROJECTS } from "@consts";
import { featuredProjects, projectVisual } from "../../lib/portfolio";
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
const featured = featuredProjects
  .map((item) => projects.find((p) => p.slug === item.slug))
  .filter((p): p is (typeof projects)[number] => !!p);
const others = projects.filter(
  (p) => !featuredProjects.some((f) => f.slug === p.slug),
);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <div class="page-intro">
    <span class="eyebrow">TAHA SAMAVATI / PROJECTS</span><h1>
      Projects &<br /><em>experiments.</em>
    </h1><p>
      Experiments, research implementations, and products. A collection of the
      things I’ve made while following a question.
    </p>
  </div>
  <div class="archive-label">
    <span class="mono">SELECTED PROJECTS</span><a
      class="mono"
      href="/#selected-work">Selected work on the homepage ↗</a>
  </div>
  <div class="project-grid">
    {
      featured.map((project) => (
        <a class="project-tile" href={`/projects/${project.slug}/`}>
          <>
            <ProjectVisual kind={projectVisual(project.slug)} />
            <div class="tile-info">
              <>
                <div>
                  <>
                    <span class="eyebrow">
                      {
                        featuredProjects.find((f) => f.slug === project.slug)
                          ?.category
                      }{" "}
                      / {featuredProjects.find((f) => f.slug === project.slug)?.year || project.data.date.getFullYear()}
                    </span>
                    <h2 data-pagefind-weight="1">{project.data.title}</h2>
                    <p>{project.data.description}</p>
                  </>
                </div>
                <span>↗</span>
              </>
            </div>
          </>
        </a>
      ))
    }
  </div>
  <div class="archive-label" style="margin-top:70px">
    <span class="mono">MORE EXPLORATIONS</span><span class="mono"
      >{others.length} PROJECTS</span>
  </div>
  <div class="writing-list">
    {
      others.map((project) => (
        <a class="article-link" href={`/projects/${project.slug}/`}>
          <>
            <span class="mono">{project.data.date.getFullYear()}</span>
            <div>
              <>
                <h2 data-pagefind-weight="1">{project.data.title}</h2>
                <p>{project.data.description}</p>
              </>
            </div>
            <span>↗</span>
          </>
        </a>
      ))
    }
  </div>
</Layout>
