<section class="comments-section" aria-labelledby="comments-title" data-pagefind-ignore lang="en">
  <h2 id="comments-title">Discussion</h2>
  <div class="giscus"></div>
</section>
<script>
  function initComments() {
    const container=document.querySelector<HTMLElement>('.giscus');
    if(!container||container.dataset.ready)return;
    container.dataset.ready='true';
    const script=document.createElement('script');
    const attributes={
      src:'https://giscus.app/client.js',
      'data-repo':'celestialtaha/celestialtaha.github.io',
      'data-repo-id':'R_kgDOHUV4DA',
      'data-category':'Announcements',
      'data-category-id':'DIC_kwDOHUV4DM4Ch7ar',
      'data-mapping':'pathname',
      'data-strict':'0',
      'data-reactions-enabled':'1',
      'data-emit-metadata':'0',
      'data-input-position':'top',
      'data-theme':'light',
      'data-lang':'en',
      'data-loading':'lazy',
      crossorigin:'anonymous',
    };
    Object.entries(attributes).forEach(([name,value])=>script.setAttribute(name,value));
    script.async=true;
    container.append(script);
  }
  initComments();
  document.addEventListener('astro:page-load',initComments);
</script>
