---
import Search from "astro-pagefind/components/Search";
---

<aside data-pagefind-ignore>
  <div id="backdrop" class="search-backdrop" hidden>
    <div
      id="pagefind-container"
      role="dialog"
      aria-modal="true"
      aria-label="Search this portfolio"
      tabindex="-1"
    >
      <div class="search-heading">
        <span class="mono">SEARCH THE PORTFOLIO</span><button
          type="button"
          data-close-search
          class="search-dismiss"
          aria-label="Close search">Close ×</button>
      </div>
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{ showImages: false, excerptLength: 20, resetStyles: false }}
      />
      <p class="search-hint">
        Search projects, research, and writing. Press Esc to close.
      </p>
    </div>
  </div>
</aside>
<script src="../scripts/search.ts"></script>
<style is:global>
  .portfolio-site {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: "Geist Sans", sans-serif;
    --pagefind-ui-primary: #292e28;
    --pagefind-ui-text: #292e28;
    --pagefind-ui-background: #f3f1e9;
    --pagefind-ui-border: #c6c9bb;
    --pagefind-ui-tag: #e7e9df;
  }
  .search-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #232d2280;
    backdrop-filter: blur(8px);
    padding: 10vh 20px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .search-backdrop[hidden] {
    display: none;
  }
  #pagefind-container {
    padding: 25px;
    max-width: 700px;
    width: 100%;
    max-height: 80vh;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 20px 90px #0002;
  }
  .search-heading {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    margin-bottom: 25px;
  }
  .search-heading > button {
    font-size: 11px;
  }
  .search-hint {
    font-size: 10px;
    color: var(--muted);
    margin-top: 20px;
  }
  .search-button {
    background: none;
    border: 0;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 6px;
    color: var(--ink);
  }
  .search-button:hover {
    color: var(--accent);
  }
  #search input {
    font-weight: 400;
  }
  #search .pagefind-ui__result-title {
    font-weight: 500;
  }
</style>
