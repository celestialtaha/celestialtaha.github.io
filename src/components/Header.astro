---
import { SITE } from "@consts";
const path = Astro.url.pathname;
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/research", label: "Research" },
  { href: "/work", label: "Experience" },
  { href: "/blog", label: "Writing" },
];
---

<header class="site-header" lang="en">
  <a class="identity" href="/" aria-label="Taha Samavati home"
    ><span class="identity-symbol" aria-hidden="true">t<span>.</span></span
    ><span>Taha Samavati<small>AI ENGINEER & RESEARCHER</small></span></a
  >
  <nav aria-label="Main navigation">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path.startsWith(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <button
      id="portfolio-search"
      class="search-button"
      type="button"
      aria-label="Search portfolio"
      aria-haspopup="dialog"
      aria-controls="pagefind-container"
      ><svg
        width="15"
        height="15"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        aria-hidden="true"
        ><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"
        ></path></svg
      ></button>
  </nav>
  <a class="header-contact" href={`mailto:${SITE.EMAIL}`}
    >Get in touch <span aria-hidden="true">↗</span></a
  >
</header>
