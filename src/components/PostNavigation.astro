---
import type { CollectionEntry } from 'astro:content';
interface Props { prevPost?: CollectionEntry<'blog'>; nextPost?: CollectionEntry<'blog'>; }
const {prevPost,nextPost}=Astro.props;
---
<nav lang="en" class="post-navigation" aria-label="More articles" data-pagefind-ignore>
  {prevPost && <a href={`/blog/${prevPost.slug}/`}><span class="eyebrow">← NEWER NOTE</span><span dir={prevPost.data.rtl?'rtl':'ltr'} lang={prevPost.data.rtl?'fa':'en'}>{prevPost.data.title}</span></a>}
  {nextPost && <a href={`/blog/${nextPost.slug}/`}><span class="eyebrow">OLDER NOTE →</span><span dir={nextPost.data.rtl?'rtl':'ltr'} lang={nextPost.data.rtl?'fa':'en'}>{nextPost.data.title}</span></a>}
</nav>
